{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "scoped",
  "version": "0.1.0",
  "identifier": "com.scoped.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "scoped",
        "width": 320,
        "height": 520,
        "minWidth": 320,
        "minHeight": 200,
        "maxWidth": 320,
        "maxHeight": 600,
        "resizable": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
